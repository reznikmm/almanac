with "config/stm32_demo_config.gpr";
project Stm32_Demo is
   for Runtime ("Ada") use "light-tasking-stm32f4";
   for Target use "arm-eabi";

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Stm32_Demo_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("stm32_demo.adb");

   package Compiler is
      for Default_Switches ("Ada") use Stm32_Demo_Config.Ada_Compiler_Switches;
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use
        ("-Wl,--gc-sections",
         "-Wl,--defsym=__stack_size=0x4000");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Ide is
      for Program_Host use "localhost:4242";
      for Communication_Protocol use "remote";
      for Connection_Tool use "st-util";
   end Ide;

end Stm32_Demo;
